{
  "name": "kindcompanion-app",
  "version": "0.0.0",
  "scripts": {
    "ng": "ng",
    "start": "ng serve",
    "build": "ng build",
    "build:prod": "ng build --configuration=production",
    "build:qa": "ng build --configuration=development",
    "build:i18n": "npm run extract-i18n && ng build --localize",
    "build:fr": "ng build --localize=fr-CA",
    "extract-i18n": "ng extract-i18n --format=xlf2",
    "serve:fr": "ng serve --configuration=fr",
    "watch": "ng build --watch --configuration development",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:ci": "jest --ci --coverage --watchAll=false",
    "test:a11y": "npm run test:ci && npm run e2e:a11y",
    "lint": "ng lint",
    "format": "prettier --write \"src/**/*.{ts,html,scss,json}\"",
    "format:check": "prettier --check \"src/**/*.{ts,html,scss,json}\"",
    "e2e": "ng e2e",
    "e2e:headless": "cypress run",
    "e2e:a11y": "cypress run --spec \"cypress/e2e/accessibility.cy.ts\"",
    "e2e:qa": "cypress run --env baseUrl=https://qa.kindcompanion.com",
    "cypress:open": "cypress open",
    "cypress:run": "cypress run",
    "analyze": "ng build --stats-json && npx webpack-bundle-analyzer dist/stats.json"
  },
  "prettier": {
    "printWidth": 100,
    "singleQuote": true,
    "overrides": [
      {
        "files": "*.html",
        "options": {
          "parser": "angular"
        }
      }
    ]
  },
  "private": true,
  "dependencies": {
    "@angular/animations": "^20.3.2",
    "@angular/cdk": "^20.2.5",
    "@angular/common": "^20.3.0",
    "@angular/compiler": "^20.3.0",
    "@angular/core": "^20.3.0",
    "@angular/forms": "^20.3.0",
    "@angular/material": "^20.2.5",
    "@angular/platform-browser": "^20.3.0",
    "@angular/router": "^20.3.0",
    "@angular/service-worker": "^20.3.2",
    "@ngx-translate/core": "^17.0.0",
    "@ngx-translate/http-loader": "^17.0.0",
    "rxjs": "~7.8.0",
    "tslib": "^2.3.0",
    "zone.js": "~0.15.0"
  },
  "devDependencies": {
    "@angular/build": "^20.3.3",
    "@angular/cli": "^20.3.3",
    "@angular/compiler-cli": "^20.3.0",
    "@angular/localize": "^20.3.2",
    "@axe-core/playwright": "^4.10.2",
    "@cypress/schematic": "^4.1.3",
    "@types/jasmine": "~5.1.0",
    "@types/jest": "^30.0.0",
    "axe-core": "^4.10.3",
    "cypress": "^15.3.0",
    "jasmine-core": "~5.9.0",
    "jest": "^30.1.3",
    "jest-preset-angular": "^15.0.1",
    "karma": "~6.4.0",
    "karma-chrome-launcher": "~3.2.0",
    "karma-coverage": "~2.2.0",
    "karma-jasmine": "~5.1.0",
    "karma-jasmine-html-reporter": "~2.1.0",
    "typescript": "~5.9.2"
  }
}
